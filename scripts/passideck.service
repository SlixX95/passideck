[Unit]
Description=PassiDeck standalone terminal wall
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
KillMode=process
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.passideck/passideck.env
ExecStart=/bin/sh -c 'exec node "$PASSIDECK_ROOT/packages/cli/src/index.js" --no-open'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
