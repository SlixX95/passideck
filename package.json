{
  "name": "@passi/passideck",
  "version": "0.8.93",
  "description": "Standalone self-hosted browser terminal wall",
  "bin": {
    "passideck": "./packages/cli/src/index.js"
  },
  "main": "packages/electron/main.js",
  "files": [
    "packages/cli/src/index.js",
    "packages/server/src/**",
    "packages/client/public/**",
    "packages/electron/**",
    "plugins/passideck-retitle/__init__.py",
    "plugins/passideck-retitle/plugin.yaml",
    "plugins/passideck-retitle/README.md",
    "scripts/prepare-assets.js",
    "scripts/install.sh",
    "scripts/passideck.service",
    "README.md",
    "docs/agent/**"
  ],
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.js",
    "dev": "bash scripts/dev-server.sh",
    "server": "node packages/server/src/index.js",
    "start": "node packages/cli/src/index.js",
    "install-local": "bash scripts/install.sh",
    "test": "node --check packages/server/src/index.js && node --check packages/client/public/app.js && python3 tests/passideck-retitle-plugin.test.py && node tests/title-retitle.test.js && node scripts/prepare-assets.js && node tests/session.test.js && node tests/upload.test.js && node tests/server-validation.test.js && node tests/ui-static.test.js && node tests/electron-backends.test.js && node tests/electron-static.test.js && node tests/browser-cdp.test.js",
    "test:browser": "node tests/browser-cdp.test.js",
    "test:browser-scroll": "node tests/browser-scroll-cdp.test.js",
    "electron": "electron .",
    "dist:electron": "electron-builder --linux AppImage --win portable",
    "test:electron": "node tests/electron-static.test.js",
    "dist:electron:mac": "electron-builder --mac dmg",
    "dist:electron:win": "electron-builder --win portable",
    "dist:electron:linux": "electron-builder --linux AppImage",
    "prepare": "node scripts/prepare-assets.js",
    "preserver": "npm run prepare-assets",
    "prestart": "npm run prepare-assets"
  },
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^12.9.0",
    "compression": "^1.8.1",
    "express": "^4.18.2",
    "ws": "^8.16.0",
    "xterm-zerolag-input": "0.3.0",
    "yaml": "^2.3.4"
  },
  "keywords": [
    "terminal",
    "multiplexer",
    "xterm",
    "pty",
    "web-terminal"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.passi.passideck",
    "productName": "PassiDeck",
    "executableName": "PassiDeck",
    "directories": {
      "app": "packages/electron",
      "output": "dist/electron"
    },
    "files": [
      "**/*",
      "!node_modules/**",
      "!package-lock.json"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "mac": {
      "target": [
        "dmg"
      ]
    }
  },
  "author": "PassiDeck contributors"
}
